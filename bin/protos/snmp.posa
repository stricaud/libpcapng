# snmp.posa — SNMP Simple Network Management Protocol
# RFC 1157 (SNMPv1), RFC 1901 / RFC 3416 (SNMPv2c), RFC 3412 (SNMPv3)
#
# Encoding: BER/ASN.1 over UDP.  The outer wrapper is always a SEQUENCE
# (universal tag 0x30), so byte 0 is a reliable content signature.
#
# Detection: byte 0 == 0x30 (primary, catches non-standard ports); UDP 161
# (agent) and UDP 162 (trap manager) are secondary disambiguation rules.
#
# Simplified BER decode strategy:
#   outer SEQUENCE tag/length
#   → version INTEGER  (tag 0x02, len 0x01, value 0/1/3)
#   → v1/v2c: community OCTET STRING (tag 0x04, len, string)
#             PDU type (application-class tag 0xA0–0xA8)
#             PDU length
#             request-id INTEGER  (variable 1–4 bytes)
#             error-status INTEGER
#             error-index INTEGER
#             VarBindList payload
#   → v3:    msgGlobalData SEQUENCE + security params + msgData; captured as
#             a single payload because the inner structure differs significantly.
#
# Missing fields in the info line (v3 path) expand to nothing automatically.

Object<main> SNMP
    abbrev "snmp"
    col "SNMP"

    # ── Outer BER SEQUENCE ────────────────────────────────────────────────────
    required uint8 sequence_tag = 0x30
        0x30 = "SEQUENCE"

    required uint8 sequence_length "Sequence Length"

    # ── version INTEGER ───────────────────────────────────────────────────────
    required uint8 version_tag = 0x02
        0x02 = "INTEGER"

    required uint8 version_tag_length "Version Length"

    required uint8 version "Version"
        0 = "SNMPv1"
        1 = "SNMPv2c"
        3 = "SNMPv3"

    # ── Version-specific structure ─────────────────────────────────────────────
    when version == 3:
        # SNMPv3: msgGlobalData SEQUENCE + msgSecurityParameters OCTET STRING
        # + msgData CHOICE follow — too many nested layers for a flat decode.
        payload v3_message "SNMPv3 Message"
    else:
        # SNMPv1 / SNMPv2c: community OCTET STRING (tag 0x04)
        required uint8 community_tag = 0x04
            0x04 = "OCTET STRING"

        required uint8 community_length "Community Length"

        required str[community_length] community_string "Community String"

        # PDU type — context-class constructed tag (0xA0–0xA8)
        required uint8 pdu_type "PDU Type"
            0xA0 = "GetRequest"
            0xA1 = "GetNextRequest"
            0xA2 = "Response"
            0xA3 = "SetRequest"
            0xA4 = "Trap"
            0xA5 = "GetBulkRequest"
            0xA6 = "InformRequest"
            0xA7 = "SNMPv2-Trap"
            0xA8 = "Report"

        required uint8 pdu_length "PDU Length"

        # request-id INTEGER (tag 0x02, variable length 1–4 bytes)
        required uint8 req_id_tag = 0x02
            0x02 = "INTEGER"

        required uint8 req_id_length "Request-ID Length"

        required bytes[req_id_length] request_id "Request-ID"

        # error-status INTEGER
        required uint8 error_status_tag = 0x02
            0x02 = "INTEGER"

        required uint8 error_status_length "Error-Status Length"

        required uint8 error_status "Error-Status"
            0  = "noError"
            1  = "tooBig"
            2  = "noSuchName"
            3  = "badValue"
            4  = "readOnly"
            5  = "genErr"
            6  = "noAccess"
            7  = "wrongType"
            8  = "wrongLength"
            9  = "wrongEncoding"
            10 = "wrongValue"
            11 = "noCreation"
            12 = "inconsistentValue"
            13 = "resourceUnavailable"
            14 = "commitFailed"
            15 = "undoFailed"
            16 = "authorizationError"
            17 = "notWritable"
            18 = "inconsistentName"

        # error-index INTEGER
        required uint8 error_index_tag = 0x02
            0x02 = "INTEGER"

        required uint8 error_index_length "Error-Index Length"

        required uint8 error_index "Error-Index"

        # Remaining bytes: VarBindList SEQUENCE OF VarBind
        payload varbinds "Variable Bindings"

    info "%s [%s] community=%s err=%s" version, pdu_type, community_string, error_status

# ── Detection rules ───────────────────────────────────────────────────────────
# Content rule first: SEQUENCE tag 0x30 at byte 0 catches non-standard ports.
# Note: 0x30 is also used by TLS, LDAP, and other BER protocols — the port
# rules below narrow the match when multiple BER protocols are on the wire.
rule udp.content@0 "\x30" => SNMP
rule udp.port == 161 => SNMP
rule udp.port == 162 => SNMP

# ── Coloring ──────────────────────────────────────────────────────────────────
# First match wins; severity rules come before direction rules.
color snmp.error_status != 0  => white red          # Application-level error
color snmp.pdu_type == 0xA4   => black yellow       # v1 Trap (alert)
color snmp.pdu_type == 0xA7   => black yellow       # SNMPv2-Trap (alert)
color snmp.pdu_type == 0xA8   => white red          # Report (v3 error / alert)
color snmp.pdu_type == 0xA2   => black lightgreen   # Response
color snmp.pdu_type == 0xA0   => black lightyellow  # GetRequest
color snmp.pdu_type == 0xA1   => black lightyellow  # GetNextRequest
color snmp.pdu_type == 0xA3   => black lightyellow  # SetRequest
color snmp.pdu_type == 0xA5   => black lightyellow  # GetBulkRequest
color snmp.pdu_type == 0xA6   => black lightyellow  # InformRequest
color snmp                    => white darkblue      # SNMP catch-all (v3 + uncolored)

# ── Wireshark-compatible aliases ──────────────────────────────────────────────
alias snmp.version       => snmp.version
alias snmp.community     => snmp.community_string
alias snmp.pdu_type      => snmp.pdu_type
alias snmp.error_status  => snmp.error_status
alias snmp.error_index   => snmp.error_index
alias snmp.request_id    => snmp.request_id
