# wireguard.posa — WireGuard VPN Protocol
# https://www.wireguard.com/papers/wireguard.pdf
#
# WireGuard encapsulates IP traffic inside ChaCha20-Poly1305-encrypted UDP
# datagrams using a Noise_IKpsk2 handshake.  Four message types share a common
# 4-byte header: byte[0] is the type (1–4); bytes[1–3] are always zero (reserved).
#
# Message types and sizes:
#   1  Handshake Initiation  — exactly  148 bytes
#   2  Handshake Response    — exactly   92 bytes
#   3  Cookie Reply          — exactly   64 bytes
#   4  Transport Data        — minimum   32 bytes (16-byte header + encrypted payload)
#
# Detection fires on the 4-byte type+reserved prefix, which is unique enough to
# identify WireGuard reliably on any UDP port.  The default port 51820 is listed
# as a secondary hint only.
#
# Objects:
#   WG_HandshakeInit   — Initiator → Responder; carries ephemeral key and encrypted static
#   WG_HandshakeResp   — Responder → Initiator; completes the Noise handshake
#   WG_CookieReply     — Either peer under load; relays a rate-limiting cookie
#   WG_Transport       — Either peer; carries ChaCha20-Poly1305 encrypted IP packets

Object<GROUP> WireGuard

# ─── Message type 1: Handshake Initiation (exactly 148 bytes) ─────────────────
# Sent by the initiator to start the Noise_IKpsk2 exchange.  The sender_index
# is a random 32-bit value the initiator assigns to this session; the responder
# must echo it back in its receiver_index field.
Object<WireGuard> WG_HandshakeInit
    abbrev "wireguard"
    col    "WireGuard"
    starts "\x01\x00\x00\x00"

    required uint8     msg_type               = 1  "Message Type"
    required bytes<3>  reserved                    "Reserved"
    required le_uint32 sender_index                "Sender Index"
    required bytes<32> unencrypted_ephemeral       "Unencrypted Ephemeral (Curve25519)"
    required bytes<48> encrypted_static            "Encrypted Static Key"
    required bytes<28> encrypted_timestamp         "Encrypted Timestamp (TAI64N)"
    required bytes<16> mac1                        "MAC1"
    required bytes<16> mac2                        "MAC2"

    info "Handshake Initiation  Sender=0x%x" sender_index

# ─── Message type 2: Handshake Response (exactly 92 bytes) ────────────────────
# Sent by the responder after verifying the initiation message.  Both peers can
# derive session keys once this message is authenticated.  encrypted_nothing is
# an empty plaintext encrypted under the session key to prove key agreement.
Object<WireGuard> WG_HandshakeResp
    abbrev "wireguard"
    col    "WireGuard"
    starts "\x02\x00\x00\x00"

    required uint8     msg_type               = 2  "Message Type"
    required bytes<3>  reserved                    "Reserved"
    required le_uint32 sender_index                "Sender Index"
    required le_uint32 receiver_index              "Receiver Index"
    required bytes<32> unencrypted_ephemeral       "Unencrypted Ephemeral (Curve25519)"
    required bytes<16> encrypted_nothing           "Encrypted Nothing"
    required bytes<16> mac1                        "MAC1"
    required bytes<16> mac2                        "MAC2"

    info "Handshake Response  Sender=0x%x  Receiver=0x%x" sender_index, receiver_index

# ─── Message type 3: Cookie Reply (exactly 64 bytes) ──────────────────────────
# Sent by a peer under load when it cannot process a handshake immediately.
# The cookie is XChaCha20-Poly1305-encrypted under a key derived from the
# responder's static key so only the legitimate initiator can read it.
Object<WireGuard> WG_CookieReply
    abbrev "wireguard"
    col    "WireGuard"
    starts "\x03\x00\x00\x00"

    required uint8     msg_type               = 3  "Message Type"
    required bytes<3>  reserved                    "Reserved"
    required le_uint32 receiver_index              "Receiver Index"
    required bytes<24> nonce                       "Nonce (XChaCha20)"
    required bytes<32> encrypted_cookie            "Encrypted Cookie"

    info "Cookie Reply  Receiver=0x%x" receiver_index

# ─── Message type 4: Transport Data (minimum 32 bytes) ────────────────────────
# Carries one or more ChaCha20-Poly1305-encrypted IP packets.  The 64-bit
# counter provides replay protection; the receiver maintains a sliding window.
# The encrypted payload is at least 16 bytes (Poly1305 authentication tag only,
# empty plaintext); normal packets are larger.
Object<WireGuard> WG_Transport
    abbrev "wireguard"
    col    "WireGuard"
    starts "\x04\x00\x00\x00"

    required uint8     msg_type               = 4  "Message Type"
    required bytes<3>  reserved                    "Reserved"
    required le_uint32 receiver_index              "Receiver Index"
    required le_uint64 counter                     "Counter (Replay Protection)"
    required payload   encrypted_encapsulated_packet "Encrypted Encapsulated Packet"

    info "Transport Data  Receiver=0x%x  Counter=%u" receiver_index, counter

# ─── Content detection (primary — port-independent) ───────────────────────────
# The 4-byte prefix uniquely identifies each WireGuard message type because
# bytes[1–3] are required to be zero by the specification.  All four rules
# must be listed so WireGuard is decoded on non-standard ports too.
rule udp.content "\x01\x00\x00\x00" => WireGuard
rule udp.content "\x02\x00\x00\x00" => WireGuard
rule udp.content "\x03\x00\x00\x00" => WireGuard
rule udp.content "\x04\x00\x00\x00" => WireGuard

# ─── Port binding (secondary hint) ────────────────────────────────────────────
rule udp.port == 51820 => WireGuard

# ─── Coloring ──────────────────────────────────────────────────────────────────
# Handshake Initiation — yellow (request/initiator)
color wireguard.msg_type == 1 => black lightyellow
# Handshake Response — green (response/responder)
color wireguard.msg_type == 2 => black lightgreen
# Cookie Reply — gray (out-of-band control, neither data nor handshake)
color wireguard.msg_type == 3 => black lightgray
# Transport Data — dark blue (encrypted tunneled payload)
color wireguard.msg_type == 4 => white darkblue
# Catch-all (e.g. future message types or partial frames)
color wireguard => white darkgray

# ─── Wireshark-compatible field aliases ───────────────────────────────────────
# Map Wireshark's wg dissector field names to the abbrevs used here so that
# display filters written against a Wireshark capture continue to work.
alias wg.type             => wireguard.msg_type
alias wg.sender           => wireguard.sender_index
alias wg.receiver         => wireguard.receiver_index
alias wg.ephemeral        => wireguard.unencrypted_ephemeral
alias wg.static           => wireguard.encrypted_static
alias wg.timestamp        => wireguard.encrypted_timestamp
alias wg.mac1             => wireguard.mac1
alias wg.mac2             => wireguard.mac2
alias wg.nonce            => wireguard.nonce
alias wg.encrypted_cookie => wireguard.encrypted_cookie
alias wg.counter          => wireguard.counter
alias wg.encrypted_packet => wireguard.encrypted_encapsulated_packet
