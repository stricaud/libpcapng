# STUN — Session Traversal Utilities for NAT (RFC 5389 / RFC 8489)
# Ports: UDP/TCP 3478 (plain STUN/TURN), 5349 (STUN/TURN over TLS/DTLS).
# The magic cookie 0x2112A442 at bytes 4-7 uniquely identifies STUN on any
# port, making content-based detection the primary and most reliable trigger.
#
# Message structure (20-byte fixed header + variable TLV attributes):
#   [0-1]   message_type   — 16-bit; bits 15-14 always 0; class in bits 8 (C1)
#                            and 4 (C0); method in remaining bits (non-contiguous
#                            groups 13-9, 7-5, 3-0). Class encoding:
#                            00=Request, 01=Indication, 10=Success, 11=Error.
#   [2-3]   message_length — byte count of attributes only (excludes 20-byte header)
#   [4-7]   magic_cookie   — MUST be 0x2112A442 (used for XOR-MAPPED-ADDRESS too)
#   [8-19]  transaction_id — 96-bit random value correlating requests to responses
#   [20..]  attributes     — TLV list: uint16 type + uint16 length + value bytes;
#                            the length field counts value bytes only; value is
#                            zero-padded to the next 4-byte boundary (padding not
#                            counted in length).
#
# Primary use cases: WebRTC ICE connectivity checks, SIP NAT traversal, TURN
# relay allocation. Commonly multiplexed on non-standard ports alongside DTLS
# and SRTP (RFC 5764), making the magic cookie the only reliable discriminator.

Object<main> STUN
    abbrev "stun"
    col "STUN"

    # [0-1] Message Type
    # Bits 15-14 are always 0 (framing marker distinguishing STUN from TURN
    # ChannelData, which uses bits 15-14 = 01).
    # Class bits: C1 at bit 8, C0 at bit 4 (interleaved with method bits).
    # Method bits: 13-9 (M11-M7), 7-5 (M6-M4), 3-0 (M3-M0) — non-contiguous.
    # The enumerated values below combine method and class for all common types.
    required uint16 message_type "Message Type"
        # ── Binding (method 0x001) — ICE connectivity checks ─────────────────
        0x0001 = "Binding Request"
        0x0011 = "Binding Indication"
        0x0101 = "Binding Success Response"
        0x0111 = "Binding Error Response"
        # ── Allocate (method 0x003, TURN RFC 5766) — relay allocation ─────────
        0x0003 = "Allocate Request"
        0x0103 = "Allocate Success Response"
        0x0113 = "Allocate Error Response"
        # ── Refresh (method 0x004, TURN) — keep allocation alive ─────────────
        0x0004 = "Refresh Request"
        0x0104 = "Refresh Success Response"
        0x0114 = "Refresh Error Response"
        # ── Send / Data (methods 0x006 / 0x007, TURN data relay) ─────────────
        0x0016 = "Send Indication"
        0x0017 = "Data Indication"
        # ── CreatePermission (method 0x008, TURN) — install peer permission ───
        0x0008 = "CreatePermission Request"
        0x0108 = "CreatePermission Success Response"
        0x0118 = "CreatePermission Error Response"
        # ── ChannelBind (method 0x009, TURN) — bind a channel number ──────────
        0x0009 = "ChannelBind Request"
        0x0109 = "ChannelBind Success Response"
        0x0119 = "ChannelBind Error Response"

    # [2-3] Attribute payload length (bytes after the fixed 20-byte header)
    required uint16 message_length "Message Length"

    # [4-7] Magic cookie — always 0x2112A442; XOR'd into XOR-MAPPED-ADDRESS etc.
    required uint32 magic_cookie "Magic Cookie"

    # [8-19] Transaction ID — 96-bit random opaque value
    required bytes<12> transaction_id "Transaction ID"

    # [20..] TLV attribute list
    # Each attribute: 2-byte type + 2-byte length (value only) + value bytes.
    # Value is zero-padded to the next 4-byte boundary; padding bytes are not
    # counted in attr_length. Comprehension-required types (< 0x8000) MUST be
    # understood by the receiver; comprehension-optional (>= 0x8000) may be
    # silently ignored.
    repeat until end as attribute "Attributes"
        label "%s" attr_type
        required uint16 attr_type "Attribute Type"
            # ── Comprehension-required (0x0000-0x7FFF) ────────────────────────
            0x0001 = "MAPPED-ADDRESS"
            0x0006 = "USERNAME"
            0x0008 = "MESSAGE-INTEGRITY"
            0x0009 = "ERROR-CODE"
            0x000C = "CHANNEL-NUMBER"
            0x000D = "LIFETIME"
            0x0012 = "XOR-PEER-ADDRESS"
            0x0013 = "DATA"
            0x0014 = "REALM"
            0x0015 = "NONCE"
            0x0016 = "XOR-RELAYED-ADDRESS"
            0x0018 = "EVEN-PORT"
            0x0019 = "REQUESTED-TRANSPORT"
            0x001A = "DONT-FRAGMENT"
            0x0020 = "XOR-MAPPED-ADDRESS"
            0x0022 = "RESERVATION-TOKEN"
            0x0024 = "PRIORITY"
            0x0025 = "USE-CANDIDATE"
            0x0054 = "ICMP"
            # ── Comprehension-optional (0x8000-0xFFFF) ────────────────────────
            0x8022 = "SOFTWARE"
            0x8023 = "ALTERNATE-SERVER"
            0x8025 = "TRANSACTION-TRANSMIT-COUNTER"
            0x8028 = "FINGERPRINT"
            0x8029 = "ICE-CONTROLLED"
            0x802A = "ICE-CONTROLLING"
            0x802B = "RESPONSE-ORIGIN"
            0x802C = "OTHER-ADDRESS"
            0x802E = "MESSAGE-INTEGRITY-SHA256"
            0x802F = "PASSWORD-ALGORITHM"
            0x8030 = "USERHASH"
        required uint16 attr_length "Attribute Length"
        required bytes[attr_length] attr_value "Value"

    info "%s" message_type


# ── Detection rules ────────────────────────────────────────────────────────────
# Content rules first: magic cookie 0x2112A442 at byte offset 4 uniquely
# identifies STUN/TURN on any port. This is the PRIMARY trigger — it covers
# WebRTC multiplexing and non-standard deployments without relying on ports.
rule udp.content@4 "\x21\x12\xa4\x42" => STUN
rule tcp.content@4 "\x21\x12\xa4\x42" => STUN
# Standard STUN/TURN port (RFC 5389 §9 / RFC 5766 §4)
rule udp.port == 3478 => STUN
rule tcp.port == 3478 => STUN
# STUN/TURN over TLS (STUNS) and DTLS (RFC 5389 §9 / RFC 7350)
rule udp.port == 5349 => STUN
rule tcp.port == 5349 => STUN


# ── Coloring rules ─────────────────────────────────────────────────────────────
# Requests (class C1=0, C0=0): outbound NAT probe or TURN allocation — yellow
color stun.message_type == 0x0001 => black lightyellow
color stun.message_type == 0x0003 => black lightyellow
color stun.message_type == 0x0004 => black lightyellow
color stun.message_type == 0x0008 => black lightyellow
color stun.message_type == 0x0009 => black lightyellow

# Indications (class C1=0, C0=1): one-way Send/Data relay messages — blue
color stun.message_type == 0x0011 => white darkblue
color stun.message_type == 0x0016 => white darkblue
color stun.message_type == 0x0017 => white darkblue

# Success Responses (class C1=1, C0=0): NAT mapping or TURN allocation OK — green
color stun.message_type == 0x0101 => black lightgreen
color stun.message_type == 0x0103 => black lightgreen
color stun.message_type == 0x0104 => black lightgreen
color stun.message_type == 0x0108 => black lightgreen
color stun.message_type == 0x0109 => black lightgreen

# Error Responses (class C1=1, C0=1): auth failure, quota, unknown attribute — red
color stun.message_type == 0x0111 => white red
color stun.message_type == 0x0113 => white red
color stun.message_type == 0x0114 => white red
color stun.message_type == 0x0118 => white red
color stun.message_type == 0x0119 => white red

# Catch-all — unrecognised or future STUN method/class combinations
color stun => black lightgray


# ── Wireshark-compatible field aliases ─────────────────────────────────────────
# These map Wireshark STUN dissector field paths (packet-stun.c) to POSA names
# so that saved display filters continue to work unchanged.
alias stun.type                   => stun.message_type
alias stun.length                 => stun.message_length
alias stun.cookie                 => stun.magic_cookie
alias stun.id                     => stun.transaction_id
alias stun.att.type               => stun.attribute.attr_type
alias stun.att.length             => stun.attribute.attr_length
alias stun.att.value              => stun.attribute.attr_value
alias stun.att.username           => stun.attribute.attr_type == 0x0006
alias stun.att.software           => stun.attribute.attr_type == 0x8022
alias stun.att.realm              => stun.attribute.attr_type == 0x0014
alias stun.att.nonce              => stun.attribute.attr_type == 0x0015
alias stun.att.mapped_address     => stun.attribute.attr_type == 0x0001
alias stun.att.xor_mapped_address => stun.attribute.attr_type == 0x0020
alias stun.att.fingerprint        => stun.attribute.attr_type == 0x8028
alias stun.att.ice_controlled     => stun.attribute.attr_type == 0x8029
alias stun.att.ice_controlling    => stun.attribute.attr_type == 0x802A
alias stun.att.priority           => stun.attribute.attr_type == 0x0024
alias stun.att.use_candidate      => stun.attribute.attr_type == 0x0025
