*~
.pcapsh_history

# build output
build/
*.so
*.dylib
*.elc

# Python bytecode
__pycache__/
*.pyc
*.pyo

# macOS metadata
.DS_Store

# pcapng capture files at repo root (test/scratch files)
*.pcapng

# ...except the protocol conformance captures, which are reference data: one
# per spec in lib/tests/protocols, regenerated with
#     protocol-conformance --write lib/tests/captures
# and committed so a protocol can be checked in Wireshark — a second opinion
# from an implementation that is not this one.
!lib/tests/captures/*.pcapng
